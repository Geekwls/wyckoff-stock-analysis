# 威科夫分析器 环境变量配置模板
# 复制此文件为 .env 并按需修改
# 说明：所有 WYCKOFF_ 前缀的变量会自动覆盖 WyckoffConfig 的默认值

# ─── 分析置信度 ───────────────────────────────────────
# 信号置信度阈值（0.0 ~ 1.0），越高越严格
# WYCKOFF_CONFIDENCE_THRESHOLD=0.85

# ─── 数据参数 ──────────────────────────────────────────
# 最小数据长度（交易日天数），低于此值拒绝分析
# WYCKOFF_MIN_DATA_LENGTH=60

# ATR 计算周期（5-50）
# WYCKOFF_ATR_PERIOD=14

# ATR 倍数阈值
# WYCKOFF_ATR_MULTIPLIER=1.5

# 成交量移动平均周期（5-100）
# WYCKOFF_VOLUME_MA_PERIOD=20

# ─── Spring 检测参数 ───────────────────────────────────
# Spring 回溯窗口（30-252 天）
# WYCKOFF_SPRING_LOOKBACK=120

# 交易区间最大振幅阈值（A股建议 0.3，波动大的市场可调高）
# WYCKOFF_SPRING_RANGE_THRESHOLD=0.30

# Spring 最大恢复天数（跌破支撑后几天内收回算有效）
# WYCKOFF_SPRING_MAX_RECOVERY_DAYS=3

# ─── 突破搜索 ──────────────────────────────────────────
# 突破信号搜索窗口（在最近 N 根 K 线内搜索）
# WYCKOFF_BREAKOUT_SEARCH_WINDOW=5

# ─── 高潮检测参数 ──────────────────────────────────────
# 高潮振幅倍数（相对于20日均幅）
# WYCKOFF_CLIMAX_RANGE_MULTIPLIER=1.5

# ─── 自适应阈值 (v1.3+) ────────────────────────────────
# 启用动态阈值自适应系统
# WYCKOFF_ENABLE_ADAPTIVE_THRESHOLDS=True

# 动态阈值 ATR 计算周期
# WYCKOFF_ADAPTIVE_THRESHOLDS_ATR_PERIOD=14

# ─── 贝叶斯自适应阈值参数 ──────────────────────────────
# 突破量比先验均值
# WYCKOFF_PRIOR_BREAKOUT_MU=1.5

# 缩量量比先验均值
# WYCKOFF_PRIOR_SHRINK_MU=0.6

# 量比先验标准差
# WYCKOFF_PRIOR_SIGMA=0.5

# 贝叶斯推断：突破日振幅截取分位数（50-99）
# WYCKOFF_AMPLITUDE_BREAKOUT_PERCENTILE=85.0

# 贝叶斯推断：缩量日振幅截取分位数（1-50）
# WYCKOFF_AMPLITUDE_SHRINK_PERCENTILE=15.0
