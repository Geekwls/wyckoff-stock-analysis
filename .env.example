# 威科夫分析器 环境变量配置模板
# 复制此文件为 .env 并按需修改
# 说明：所有 WYCKOFF_ 前缀的变量会自动覆盖 WyckoffConfig 的默认值

# ─── 分析置信度 ───────────────────────────────────────
# 信号置信度阈值（0.0 ~ 1.0），越高越严格
# WYCKOFF_CONFIDENCE_THRESHOLD=0.85

# ─── 数据参数 ──────────────────────────────────────────
# 最小数据长度（交易日天数），低于此值拒绝分析
# WYCKOFF_MIN_DATA_LENGTH=60

# ─── Spring 检测参数 ───────────────────────────────────
# 交易区间最大振幅阈值（A股建议 0.3，波动大的市场可调高）
# WYCKOFF_SPRING_RANGE_THRESHOLD=0.30

# Spring 最大恢复天数（跌破支撑后几天内收回算有效）
# WYCKOFF_SPRING_MAX_RECOVERY_DAYS=3

# ─── 高潮检测参数 ──────────────────────────────────────
# 高潮成交量倍数（相对于均量，超过此值才认定为高潮）
# WYCKOFF_CLIMAX_VOL_MULTIPLIER=3.0

# 高潮振幅倍数（相对于20日均幅）
# WYCKOFF_CLIMAX_RANGE_MULTIPLIER=1.5
